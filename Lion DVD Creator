#!/bin/bash
# Installer Mac OS X Lion
# (c) Copyright 2026 chris1111 
# This will create an iso of Mac OS X Lion
set -u

# --- configuration ------------------------------------------------------------
APPTITLE="Installer Mac OS X Lion"
VERSION="1.0"
ICON="/System/Library/CoreServices/Finder.app/Contents/Resources/Finder.icns"

SRC_MOUNT="/Volumes/Installer-OS"
DVD_MOUNT="/Volumes/Mac-OSX-Install-DVD"
SPARSE="/private/tmp/MacOS.sparseimage"
ISO="$HOME/Desktop/Mac OS X Install DVD.iso"

# --- helpers -------------------------------------------------------------------
banner() {
    printf '\n**********************************************\n%s\n**********************************************\n' "$*"
}

notify() {    # notify <message> <subtitle>  (needs 10.8+; silently ignored on Lion)
    osascript -e "display notification \"$1\" with title \"$APPTITLE\" subtitle \"$2\"" >/dev/null 2>&1 || true
}

cancelled() {
    notify "Program closing" "User cancelled"
    exit 0
}

focus_terminal() {
    osascript -e 'tell application "Terminal" to activate' >/dev/null 2>&1 || true
}

fail() {      # fail <message>
    echo "ERROR: $*" >&2
    dialog_ok "ERROR: $*"
    exit 1
}

dialog_ok() { # dialog_ok <message>
    osascript - "$1" "$APPTITLE $VERSION" "$ICON" >/dev/null 2>&1 <<'OSA'
on run {msg, ttl, iconFile}
    tell application "System Events"
        display dialog msg buttons {"OK"} default button 1 with title ttl with icon POSIX file iconFile giving up after 5
    end tell
end run
OSA
}

intro_dialog() {
    local msg
    msg=$(printf '%s\n\n%s\n%s\n\n%s' \
        "This program will create a bootable ISO image of Lion and determine the size of the DVD to use (4.7 GB or 8.5 GB) depending on the size of your Install Mac OS X Lion.app." \
        "NOTE:" \
        "If a \"Mac OS X Install DVD.iso\" already exists on the Desktop it will be deleted by this script. Move any images you want to keep elsewhere before continuing." \
        "Select OK to continue, Cancel to quit.")
    osascript - "$msg" "$APPTITLE $VERSION" "$ICON" >/dev/null 2>&1 <<'OSA'
on run {msg, ttl, iconFile}
    tell application "System Events"
        display dialog msg buttons {"Cancel", "OK"} default button 2 with title ttl with icon POSIX file iconFile
    end tell
end run
OSA
}

choose_app() {
    osascript 2>/dev/null <<'OSA'
tell application "Finder"
    activate
    set f to choose file default location "/Applications" with prompt "Choose your Install Mac OS X Lion.app"
    return POSIX path of f
end tell
OSA
}

# --- always clean up, even on error or Ctrl-C -----------------------------------
cleanup() {
    hdiutil detach -force "$DVD_MOUNT" >/dev/null 2>&1 || true
    hdiutil detach -force "$SRC_MOUNT" >/dev/null 2>&1 || true
    [ -e "$SPARSE" ] && rm -rf "$SPARSE"
    true
}
trap cleanup EXIT

# --- sanity checks ---------------------------------------------------------------
if [ "$(uname)" != "Darwin" ]; then
    echo "This script must run on macOS." >&2
    exit 1
fi

PARENTDIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PARENTDIR" || exit 1
find . -name '.DS_Store' -type f -delete 2>/dev/null

# --- start -------------------------------------------------------------------------
intro_dialog || cancelled

banner "Starting Mac OS X Install DVD!"

# detach leftovers from previous runs
hdiutil detach -force "$DVD_MOUNT"              >/dev/null 2>&1 || true
hdiutil detach -force "/Volumes/Mac OS X Install DVD" >/dev/null 2>&1 || true
hdiutil detach -force "$SRC_MOUNT"              >/dev/null 2>&1 || true

# start from a clean slate (correct file tests this time)
[ -e "$SPARSE" ] && rm -rf "$SPARSE"
if [ -e "$ISO" ]; then
    echo "Removing existing: $ISO"
    rm -f "$ISO"
fi

# --- pick the installer app ----------------------------------------------------------
APP_PATH="$(choose_app)" || cancelled
[ -n "$APP_PATH" ] || cancelled
echo "Selected: $APP_PATH"

ESD="$APP_PATH/Contents/SharedSupport/InstallESD.dmg"
[ -f "$ESD" ] || fail "The selected app has no Contents/SharedSupport/InstallESD.dmg — is it really Install Mac OS X Lion.app?"

# --- mount InstallESD -----------------------------------------------------------------
mkdir -p "$SRC_MOUNT"
hdiutil attach "$ESD" -noverify -nobrowse -mountpoint "$SRC_MOUNT" || fail "Could not mount InstallESD.dmg."
sleep 2
focus_terminal

# --- build a sparse image from BaseSystem.dmg -------------------------------------------
[ -f "$SRC_MOUNT/BaseSystem.dmg" ] || fail "BaseSystem.dmg not found in the installer image."
hdiutil convert "$SRC_MOUNT/BaseSystem.dmg" -format UDSP -o /private/tmp/MacOS || fail "BaseSystem.dmg conversion failed."

# choose DVD size from the app's size (4 GB = 4000 MB)
SIZE_MB=$(du -sm "$APP_PATH" | awk '{print $1}')
if [ "$SIZE_MB" -lt 4000 ]; then
    echo "This app is smaller than 4 GB ($SIZE_MB MB) — 4.7 GB DVD needed."
    dialog_ok "You need a 4.7 GB DVD for this app."
    hdiutil resize -size 4.2g "$SPARSE"
else
    echo "This app is 4 GB or larger ($SIZE_MB MB) — 8.5 GB DVD needed."
    dialog_ok "You need an 8.5 GB DVD for this app."
    hdiutil resize -size 7g "$SPARSE"
fi

# --- mount the sparse image and populate it ----------------------------------------------
mkdir -p "$DVD_MOUNT"
hdiutil attach "$SPARSE" -noverify -nobrowse -mountpoint "$DVD_MOUNT" || fail "Could not mount the sparse image."

banner "Copying essential files!"
[ -f "$SRC_MOUNT/mach_kernel" ] && cp -Rp "$SRC_MOUNT/mach_kernel" "$DVD_MOUNT/"

echo "Copying Packages — this can take a while..."
rm -rf "$DVD_MOUNT/System/Installation/Packages"
cp -Rp "$SRC_MOUNT/Packages" "$DVD_MOUNT/System/Installation/Packages" || fail "Could not copy Packages."

mkdir -p "$DVD_MOUNT/Lion DVD Creator"
cp -Rp ./* "$DVD_MOUNT/Lion DVD Creator/"

# --- Chameleon extras: PC or Laptop -------------------------------------------------------
banner "Install Chameleon!"
echo "Select 1 for PC or 2 for Laptop, then press Enter."

# NOTE: 'DVD-Lptop' is the folder name shipped with the original package (sic)
PS3="Please enter your choice (1-2): "
select opt in "PC" "Laptop"; do
    case "$opt" in
        PC)     echo "You selected PC";     cp -Rp ./DVD-PC/*    "$DVD_MOUNT/" || fail "DVD-PC copy failed.";    break ;;
        Laptop) echo "You selected Laptop"; cp -Rp ./DVD-Lptop/* "$DVD_MOUNT/" || fail "DVD-Lptop copy failed."; break ;;
        *)      echo "Invalid option. Try again." ;;
    esac
done

# --- install log ---------------------------------------------------------------------------
EXTRA_DIR="$DVD_MOUNT/Extra"
mkdir -p "$EXTRA_DIR"
LOG="$EXTRA_DIR/Chameleon_Install_Log.txt"
{
    echo ""
    echo "Chameleon installer log - $(date)"
    echo "Installer version: Chameleon v2.4svn rev 2923"
    echo "Built by chris1111 — Xcode Version 9.4.1 (9F2000)"
    echo "======================================================"
    diskutil list
    echo "======================================================"
    echo "Using cdboot on $DVD_MOUNT — no active partition"
    echo "Chameleon installation finished"
} > "$LOG"

# --- shrink image, then build the ISO -------------------------------------------------------
hdiutil detach -force "$DVD_MOUNT"
hdiutil resize -size "$(hdiutil resize -limits "$SPARSE" | tail -n 1 | awk '{print $1}')b" "$SPARSE"
sleep 2
hdiutil attach "$SPARSE" -noverify -nobrowse -mountpoint "$DVD_MOUNT" || fail "Could not re-mount the sparse image."
focus_terminal

CDBOOT="$DVD_MOUNT/usr/standalone/i386/cdboot"
[ -f "$CDBOOT" ] || fail "cdboot not found — cannot make a bootable ISO."

banner "Create ISO image — type your password if asked"
sudo hdiutil makehybrid -o "$ISO" "$DVD_MOUNT" -iso -hfs -joliet \
    -eltorito-boot "$CDBOOT" -no-emul-boot \
    -hfs-volume-name "Mac OS X Install DVD" \
    -joliet-volume-name "Mac OS X Install DVD" || fail "makehybrid failed."

[ -f "$ISO" ] || fail "The ISO was not created."

banner "Unmounting installer images!"
sleep 1
hdiutil detach -force "$SRC_MOUNT"
hdiutil detach -force "$DVD_MOUNT"
rm -rf "$SPARSE"

# --- burn or exit ----------------------------------------------------------------------------
banner "Burn the DVD?"
PS3="Please enter your choice (1-2): "
select opt in "Burn the DVD" "Exit"; do
    case "$opt" in
        "Burn the DVD")
            echo "You selected: Burn the DVD"
            hdiutil burn -noverifyburn "$ISO" || echo "Burning failed."
            sleep 1
            open -R "$ISO"
            break
            ;;
        "Exit")
            echo "You chose to quit"
            sleep 1
            open -R "$ISO"
            break
            ;;
        *) echo "Invalid option. Try again." ;;
    esac
done

exit 0